# Banco PostgreSQL gerenciado (Supabase - usar Session/Transaction Pooler em ambiente serverless)
DATABASE_URL=""

# Senha compartilhada para acesso à aplicação (validada exclusivamente no servidor)
APP_ACCESS_PASSWORD=""

# Segredo para assinatura HMAC dos cookies de sessão (mínimo recomendado: 32 caracteres aleatórios)
APP_SESSION_SECRET=""

# Ambiente de execução (development | production | test - gerenciada automaticamente pelo runtime)
# NODE_ENV="development"
